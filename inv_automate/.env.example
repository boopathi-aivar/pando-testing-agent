# Copy to .env and fill in values.
# AWS access keys: use `aws configure` (do NOT put keys here).

# bedrock | ollama
LLM_PROVIDER=bedrock

# AWS region (must match where the inference profile / model is enabled)
AWS_REGION=us-east-1

# Same env names as Batch — use your Sonnet 4.5 inference profile ARN
AWS_BEDROCK_INFERENCE_GLOBAL_ID=arn:aws:bedrock:us-east-1:YOUR_ACCOUNT_ID:inference-profile/global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional alias (used if AWS_BEDROCK_INFERENCE_GLOBAL_ID is empty):
# BEDROCK_MODEL_ARN=

# Optional Bedrock tuning
# BEDROCK_MAX_TOKENS=8192
# BEDROCK_READ_TIMEOUT=300

# --- Local Ollama fallback (when LLM_PROVIDER=ollama) ---
# OLLAMA_MODEL=gemma4:e2b
# OLLAMA_BASE_URL=http://localhost:11434

# Shared
LLM_TEMPERATURE=0
ACCURACY_THRESHOLD=0.75
