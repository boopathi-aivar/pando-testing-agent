#!/usr/bin/env python3
"""
S3 Re-trigger Script
────────────────────
Searches for a given message_id (S3 object key) in the configured S3 bucket,
then re-uploads (copies) the object with a new name to trigger reprocessing.

Naming convention:
  - First re-trigger : <message_id>_retrigger_1
  - Subsequent       : <message_id>_retrigger_N  (N increments from the highest existing)

Usage:
  python s3_retrigger.py <message_id> [<message_id_2> ...]

Examples:
  python s3_retrigger.py 7505rh5k27h55t44qqpbeh7gr0sphla3mf9k2vo1
  python s3_retrigger.py msg_id_1 msg_id_2 msg_id_3
"""

import sys
import re
import boto3
from botocore.exceptions import ClientError

# ─── CONFIGURATION ────────────────────────────────────────────────────────────
S3_BUCKET_NAME = "delicato-demo-mail-watcher-dest"  # ← UPDATE THIS
AWS_REGION     = "us-east-1"
# ──────────────────────────────────────────────────────────────────────────────

SEP = "─" * 65


def get_s3_client():
    """Create and return an S3 client."""
    return boto3.client("s3", region_name=AWS_REGION)


def object_exists(s3_client, bucket: str, key: str) -> bool:
    """Check if an object exists in S3."""
    try:
        s3_client.head_object(Bucket=bucket, Key=key)
        return True
    except ClientError as e:
        if e.response["Error"]["Code"] == "404":
            return False
        raise


def get_current_retrigger_count(s3_client, bucket: str, message_id: str) -> int:
    """
    List objects in the bucket with prefix matching the message_id and find
    the highest existing retrigger count.

    Returns 0 if no retrigger copies exist yet.
    """
    # Pattern: <message_id>_retrigger_<N>
    retrigger_pattern = re.compile(
        rf"^{re.escape(message_id)}_retrigger_(\d+)$"
    )

    max_count = 0
    paginator = s3_client.get_paginator("list_objects_v2")

    # Use the message_id as prefix to narrow down listing
    for page in paginator.paginate(Bucket=bucket, Prefix=message_id):
        for obj in page.get("Contents", []):
            key = obj["Key"]
            match = retrigger_pattern.match(key)
            if match:
                count = int(match.group(1))
                if count > max_count:
                    max_count = count

    return max_count


def retrigger_object(s3_client, bucket: str, message_id: str) -> str:
    """
    Copy the original S3 object to a new key with incremented retrigger count.

    Returns the new object key on success.
    Raises an exception if the original object does not exist.
    """
    # 1. Verify original object exists
    if not object_exists(s3_client, bucket, message_id):
        raise FileNotFoundError(
            f"Original object not found in S3: s3://{bucket}/{message_id}"
        )

    # 2. Determine next retrigger count
    current_count = get_current_retrigger_count(s3_client, bucket, message_id)
    next_count = current_count + 1
    new_key = f"{message_id}_retrigger_{next_count}"

    # 3. Copy the object (same content, new key)
    copy_source = {"Bucket": bucket, "Key": message_id}
    s3_client.copy_object(
        Bucket=bucket,
        Key=new_key,
        CopySource=copy_source,
    )

    return new_key


def main():
    if len(sys.argv) < 2:
        print("Usage: python s3_retrigger.py <message_id> [<message_id_2> ...]")
        print("Example: python s3_retrigger.py 7505rh5k27h55t44qqpbeh7gr0sphla3mf9k2vo1")
        sys.exit(1)

    message_ids = sys.argv[1:]

    if S3_BUCKET_NAME == "your-bucket-name-here":
        print("⚠️  ERROR: Please update S3_BUCKET_NAME in the script configuration.")
        sys.exit(1)

    print(f"\n{'=' * 65}")
    print(f"  S3 RE-TRIGGER")
    print(f"{'=' * 65}")
    print(f"  Bucket       : {S3_BUCKET_NAME}")
    print(f"  Region       : {AWS_REGION}")
    print(f"  Message IDs  : {len(message_ids)}")
    print(f"{'=' * 65}")

    s3_client = get_s3_client()

    success_count = 0
    fail_count = 0

    for idx, message_id in enumerate(message_ids, 1):
        message_id = message_id.strip()
        if not message_id:
            continue

        print(f"\n{SEP}")
        print(f"  [{idx}/{len(message_ids)}]  Processing: {message_id}")
        print(SEP)

        try:
            # Check current retrigger count
            current_count = get_current_retrigger_count(s3_client, S3_BUCKET_NAME, message_id)
            if current_count > 0:
                print(f"  Existing retriggers found: {current_count}")
            else:
                print(f"  No previous retriggers found — this will be the first.")

            # Perform the retrigger
            new_key = retrigger_object(s3_client, S3_BUCKET_NAME, message_id)
            print(f"  ✓ Re-triggered successfully!")
            print(f"    Source : s3://{S3_BUCKET_NAME}/{message_id}")
            print(f"    New    : s3://{S3_BUCKET_NAME}/{new_key}")
            success_count += 1

        except FileNotFoundError as e:
            print(f"  ✗ {e}")
            fail_count += 1
        except ClientError as e:
            print(f"  ✗ AWS Error: {e}")
            fail_count += 1
        except Exception as e:
            print(f"  ✗ Unexpected error: {e}")
            fail_count += 1

    # ── Summary ───────────────────────────────────────────────────────────────
    print(f"\n{'=' * 65}")
    print(f"  SUMMARY")
    print(f"{'=' * 65}")
    print(f"  Total processed : {len(message_ids)}")
    print(f"  Succeeded       : {success_count}")
    print(f"  Failed          : {fail_count}")
    print(f"{'=' * 65}\n")


if __name__ == "__main__":
    main()
