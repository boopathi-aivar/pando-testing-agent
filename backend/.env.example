PROJECTS_TABLE=invoice-testing-agent-projects
RESULTS_TABLE=invoice-testing-agent-results
JOBS_TABLE=invoice-testing-agent-jobs
JWT_SECRET_KEY=change-me-in-production
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
LOG_GROUP_PREFIX=/aws/lambda/invoice-processor
ANTHROPIC_API_KEY=sk-ant-...
INTAKE_API_KEY=your-shared-secret-with-lambda
# rapidocr (default) | paddleocr | off
PDF_OCR_ENGINE=rapidocr
# auto = native text when present, OCR scans. always = OCR every page.
PDF_OCR_MODE=auto
# Local PDF override: set true and a path to skip S3 for one file.
LOCAL_INVOICE_PDF=false
LOCAL_INVOICE_PDF_PATH=
